---
import Layout from '@/layouts/Layout.astro';
import { SetupForm } from './SetupForm';
---

<Layout>
  <div class="min-h-screen w-full flex items-center justify-center bg-gradient-to-tr from-slate-50 via-indigo-50/20 to-blue-50/40 p-4 sm:p-6 md:p-10 relative overflow-hidden font-sans">
    <!-- Decorative background blobs -->
    <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-500/5 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-violet-600/5 blur-[120px] pointer-events-none"></div>

    <div class="w-full max-w-xl relative z-10 animate-fade-in">
      <!-- Logo or Brand Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl overflow-hidden shadow-lg shadow-slate-200/80 mb-4 bg-[#4a6da7]">
          <img src="/jw-logo.svg" alt="JW Logo" class="w-full h-full object-cover" />
        </div>
        <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">
          Completar Perfil
        </h1>
        <p class="text-slate-500 text-sm mt-2 font-medium">
          Por favor ingresa tus datos para configurar tu cuenta
        </p>
      </div>

      <!-- React Setup Form Island -->
      <SetupForm client:load />
    </div>
  </div>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideIn {
      from { opacity: 0; transform: translateY(-5px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .animate-slide-in {
      animation: slideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</Layout>
