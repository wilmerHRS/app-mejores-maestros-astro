---
import Layout from '@/layouts/Layout.astro';
import { verifyFirebaseSessionCookie } from '@/shared/api';

const session = Astro.cookies.get('session')?.value;
let user: { email?: string; uid: string } | null = null;

if (session) {
  try {
    const decodedToken = await verifyFirebaseSessionCookie(session);
    user = {
      email: decodedToken.email,
      uid: decodedToken.uid
    };
  } catch (error) {
    // Invalid session, treated as guest
  }
}
---

<Layout>
  <div class="min-h-screen bg-zinc-950 text-slate-100 flex flex-col font-sans antialiased relative overflow-hidden">
    <!-- Decorative Ambient Lighting -->
    <div class="absolute top-[-30%] left-[-20%] w-[80%] h-[80%] rounded-full bg-indigo-500/10 blur-[150px] pointer-events-none"></div>
    <div class="absolute bottom-[-30%] right-[-20%] w-[80%] h-[80%] rounded-full bg-violet-600/10 blur-[150px] pointer-events-none"></div>

    <!-- Navigation Header -->
    <header class="border-b border-white/5 backdrop-blur-md bg-zinc-950/80 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow-lg shadow-indigo-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="white" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 018.924 5.84c-.876.241-1.763.513-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342M12 13.489a50.702 50.702 0 017.74-3.342M12 13.489V21" />
              </svg>
            </div>
            <span class="font-bold text-lg bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-300">
              Mejores Maestros
            </span>
          </div>

          <div class="flex items-center gap-4">
            {user ? (
              <a
                href="/dashboard"
                class="px-4 py-2 text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-lg shadow-indigo-500/20 transition-all duration-300 cursor-pointer"
              >
                Ir al Panel
              </a>
            ) : (
              <a
                href="/login"
                class="px-4 py-2 text-xs font-semibold bg-white/5 border border-white/10 hover:bg-white/10 rounded-xl transition-all duration-300 cursor-pointer"
              >
                Iniciar Sesión
              </a>
            )}
          </div>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <main class="flex-grow flex flex-col items-center justify-center max-w-5xl mx-auto px-4 text-center py-20 relative z-10">
      <div class="space-y-6 max-w-3xl animate-fade-in">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-medium tracking-wide uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
          Calificaciones verificadas por estudiantes
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
          Encuentra y Califica a los <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400">
            Mejores Maestros
          </span>
        </h1>

        <p class="text-slate-400 text-lg max-w-2xl mx-auto leading-relaxed">
          Una plataforma segura y colaborativa para compartir reseñas sobre catedráticos, evaluar metodologías de enseñanza y planificar tu éxito académico.
        </p>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          {user ? (
            <div class="flex flex-col sm:flex-row items-center gap-4">
              <a
                href="/dashboard"
                class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white font-semibold rounded-xl shadow-xl shadow-indigo-500/20 hover:shadow-indigo-500/30 transition-all duration-300 transform active:scale-95 flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>Ir a tu Dashboard</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <span class="text-xs text-slate-500">Conectado como {user.email}</span>
            </div>
          ) : (
            <a
              href="/login"
              class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white font-semibold rounded-xl shadow-xl shadow-indigo-500/20 hover:shadow-indigo-500/30 transition-all duration-300 transform active:scale-95 flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Iniciar Sesión</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Feature Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 w-full mt-24">
        <div class="backdrop-blur-xl bg-white/[0.02] border border-white/5 rounded-2xl p-6 text-left hover:border-white/10 transition-colors group">
          <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center mb-4 group-hover:bg-indigo-500 group-hover:text-white transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.746 3.746 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Seguro y Anónimo</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Tus datos de cuenta están completamente protegidos mediante cifrado Firebase. Tu opinión importa y se mantiene confidencial.
          </p>
        </div>

        <div class="backdrop-blur-xl bg-white/[0.02] border border-white/5 rounded-2xl p-6 text-left hover:border-white/10 transition-colors group">
          <div class="w-10 h-10 rounded-xl bg-violet-500/10 text-violet-400 flex items-center justify-center mb-4 group-hover:bg-violet-500 group-hover:text-white transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Métricas en Detalle</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Califica según la puntualidad, dominio del tema, nivel de dificultad y claridad en las explicaciones para dar una visión de 360 grados.
          </p>
        </div>

        <div class="backdrop-blur-xl bg-white/[0.02] border border-white/5 rounded-2xl p-6 text-left hover:border-white/10 transition-colors group">
          <div class="w-10 h-10 rounded-xl bg-pink-500/10 text-pink-400 flex items-center justify-center mb-4 group-hover:bg-pink-500 group-hover:text-white transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94-3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Comunidad Inteligente</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Toma mejores decisiones en tu inscripción de materias basándote en la experiencia colectiva de otros compañeros.
          </p>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/5 py-8 mt-12">
      <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
        &copy; 2026 Mejores Maestros. Todos los derechos reservados.
      </div>
    </footer>
  </div>
</Layout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
