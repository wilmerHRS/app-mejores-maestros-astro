---
import Layout from "./Layout.astro";
import { Header } from "@/_pages/dashboard/ui/Header";
import { Sidebar } from "@/_pages/dashboard/ui/Sidebar";
import type { UserProfile, Congregation } from "@/shared/api";

interface Props {
  activeTab: "inicio" | "brothers" | "life-ministry" | "groups" | "activity-guides";
  profile: UserProfile;
  congregation: Congregation | null;
  userEmail: string | undefined;
}

const { activeTab, profile, congregation, userEmail } = Astro.props;
---

<Layout>
  <div
    class="h-screen w-screen overflow-hidden bg-gradient-to-tr from-slate-50 via-indigo-50/20 to-blue-50/40 text-slate-800 flex flex-col font-sans antialiased relative"
  >
    <!-- Background Glows -->
    <div
      class="absolute top-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-[#4a6da7]/3 blur-[120px] pointer-events-none"
    >
    </div>
    <div
      class="absolute bottom-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-violet-500/3 blur-[120px] pointer-events-none"
    >
    </div>

    <!-- Header Navigation (Persisted across transitions) -->
    <Header
      userProfile={profile}
      congregation={congregation}
      userEmail={userEmail}
      client:load
      transition:persist
    />

    <!-- Sidebar + Slot Layout (Sidebar persisted across transitions) -->
    <div
      class="flex flex-col md:flex-row flex-grow w-full relative min-h-0 overflow-hidden"
    >
      <Sidebar activeTab={activeTab} client:load transition:persist />

      <div class="flex-grow overflow-y-auto p-6 md:p-10 min-w-0 h-full">
        <div class="max-w-7xl w-full mx-auto pb-12">
          {/* Greeting and Header depending on activeTab */}
          <div class="mb-8">
            <div
              class="flex items-center gap-2 text-xs font-bold text-[#4a6da7] uppercase tracking-widest mb-2 select-none"
            >
              <span>
                {
                  activeTab === "inicio"
                    ? "Panel General"
                    : activeTab === "brothers"
                      ? "Congregación > Hermanos"
                      : activeTab === "groups"
                        ? "Congregación > Grupos"
                        : activeTab === "activity-guides"
                          ? "Congregación > Guías de Actividades"
                          : "Reunión > Vida y Ministerio"
                }
              </span>

              <span class="w-1 h-1 rounded-full bg-[#4a6da7]/60"></span>
              <span
                >{congregation ? congregation.name : "Sin Congregación"}</span
              >
            </div>

            {
              activeTab === "inicio" && (
                <>
                  <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 animate-fade-in">
                    ¡Hola, {profile.name}! 👋
                  </h2>
                   <p class="text-slate-500 text-sm mt-2 max-w-2xl leading-relaxed font-medium animate-fade-in">
                     Consulta la programación de la reunión de entre semana y el
                     estado de las asignaciones de tu congregación.
                   </p>
                </>
              )
            }
          </div>

          <slot />
        </div>
      </div>
    </div>
  </div>
</Layout>
