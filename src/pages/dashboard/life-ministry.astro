---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { LifeMinistryTab } from '@/_pages/dashboard';
import { getDashboardData } from '@/_pages/dashboard/index.server';

const { profile, congregation, userEmail, currentWeek } = await getDashboardData(Astro.cookies, Astro.redirect);
---
<DashboardLayout activeTab="life-ministry" profile={profile} congregation={congregation} userEmail={userEmail}>
  <LifeMinistryTab
    client:load
    congregationId={profile.congregationId}
    congregationName={congregation?.name}
    currentUserUid={profile.uid}
    initialGuideId={currentWeek?.guideId}
    initialWeekId={currentWeek?.id}
    hasAuxiliaryRoom={congregation?.hasAuxiliaryRoom}
    allowMinorsAsAssistants={congregation?.allowMinorsAsAssistants}
    allowSameWeekRepetition={congregation?.allowSameWeekRepetition}
  />
</DashboardLayout>
