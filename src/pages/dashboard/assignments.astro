---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { AssignmentsTab } from '@/_pages/dashboard';
import { getDashboardData } from '@/_pages/dashboard/index.server';

const { profile, congregation, userEmail } = await getDashboardData(Astro.cookies, Astro.redirect);
---
<DashboardLayout activeTab="assignments" profile={profile} congregation={congregation} userEmail={userEmail}>
  <AssignmentsTab client:load congregationId={profile.congregationId} meetingDay={congregation?.meetingDay ?? 5} />
</DashboardLayout>
