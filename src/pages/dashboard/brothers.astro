---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { BrothersTab } from '@/_pages/dashboard';
import { getDashboardData } from '@/_pages/dashboard/index.server';

const { profile, congregation, userEmail } = await getDashboardData(Astro.cookies, Astro.redirect);
---
<DashboardLayout activeTab="brothers" profile={profile} congregation={congregation} userEmail={userEmail}>
  <BrothersTab client:load congregationId={profile.congregationId} />
</DashboardLayout>
