---
import { verifyFirebaseSessionCookie, checkUserExists } from '@/shared/api/index.server';

const session = Astro.cookies.get('session')?.value;

if (!session) {
  return Astro.redirect('/login');
}

try {
  const decoded = await verifyFirebaseSessionCookie(session);
  const hasProfile = await checkUserExists(decoded.uid);
  if (hasProfile) {
    return Astro.redirect('/dashboard');
  } else {
    return Astro.redirect('/setup');
  }
} catch (error) {
  // Session cookie is invalid or expired
  Astro.cookies.delete('session', { path: '/' });
  return Astro.redirect('/login');
}
